#!/usr/bin/env bash

set -u

status_url="${GITHUB_STATUS_URL:-https://www.githubstatus.com/api/v2/status.json}"
status_json="$(curl --fail --silent --show-error --max-time 10 --retry 2 "$status_url")" || exit 1
indicator="$(printf '%s' "$status_json" | jq -r '.status.indicator // "unknown"')"

if [ "$indicator" = "none" ] || [ "$indicator" = "unknown" ]; then
  exit 1
fi

description="$(printf '%s' "$status_json" | jq -r '.status.description // "GitHub service incident"')"
echo "GitHub Status reports ${indicator}: ${description}"
