---
import BaseLayout from "@layouts/BaseLayout.astro";

const description =
  "About Council Discourse, an independent NYC Council meeting transcript and chaptering project.";
---

<BaseLayout title="About" description={description} canonicalPath="/about/">
  <section class="mx-auto max-w-reading px-4 py-10 md:px-6">
    <div class="prose-site space-y-5 leading-8">
      <h1 class="font-serif text-4xl font-semibold leading-tight text-ink">About Council Discourse</h1>
      <p>
        Council Discourse publishes NYC Council meeting transcripts, speaker names, summaries, and
        direct video links generated by an automated pipeline.
      </p>
      <p>
        Council Discourse follows the idea and core methodology of
        <a href="https://vikramoberoi.com/">Vikram Oberoi</a>'s
        <a href="https://citymeetings.nyc/">citymeetings.nyc</a>: same-day transcription,
        speaker naming, and LLM chaptering, documented in his public talks and writing. This is an
        independent reimplementation that modifies his approach.
      </p>
      <h2>FAQ</h2>
      <p>
        Transcripts, speaker names, summaries, and chapters are generated by AI and may contain
        errors. Report corrections by email.
      </p>
    </div>
  </section>
</BaseLayout>
