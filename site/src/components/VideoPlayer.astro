---
interface Props {
  url: string;
  startSec: number;
  title: string;
}

const { url, startSec, title } = Astro.props;
---

<link rel="stylesheet" href="https://vjs.zencdn.net/8.23.4/video-js.css" />

<div class="chapter-video border border-line bg-black">
  <video
    id="chapter-video"
    class="video-js vjs-default-skin vjs-big-play-centered vjs-16-9"
    controls
    preload="metadata"
    playsinline
    data-chapter-video
    data-start={startSec}
    aria-label={title}
  >
    <source src={url} type="video/mp4" />
  </video>
</div>

<script is:inline defer src="https://vjs.zencdn.net/8.23.4/video.min.js"></script>
<script is:inline>
  function setupChapterVideo() {
    const element = document.querySelector("[data-chapter-video]");
    if (!element || element.dataset.videoReady === "true" || !window.videojs) {
      return;
    }
    element.dataset.videoReady = "true";

    const start = Number(element.dataset.start || 0);
    const player = window.videojs(element, {
      controls: true,
      fluid: true,
      preload: "metadata",
    });

    // Seek to the chapter start once metadata loads. No pause here: iOS loads
    // metadata only after the first tap on play, and pausing would force a
    // second tap. Skip the seek if a transcript timestamp was already used.
    let seeked = false;
    player.ready(() => {
      player.one("loadedmetadata", () => {
        if (!seeked) {
          player.currentTime(start);
        }
      });
      window.chapterVideoPlayer = player;
    });

    window.seekChapterVideo = (seconds) => {
      seeked = true;
      const wasPaused = player.paused();
      player.currentTime(Number(seconds));
      if (wasPaused) {
        player.pause();
      }
    };
  }

  // video.min.js is deferred, so it has run by DOMContentLoaded.
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupChapterVideo, { once: true });
  } else {
    setupChapterVideo();
  }
</script>
